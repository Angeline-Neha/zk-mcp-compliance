+          opacity: active ? undefined : 0.7,
+          animation: active ? "pulse-seal 2.5s ease-in-out infinite" : undefined,
+        }}
+      >
+        ▓▓▓▓▓▓▓▓
+      </span>
+    </div>
+  );
+}
