-function ProofDisplay({
-  parsed,
-}: {
-  parsed: NonNullable<ReturnType<typeof toolCallToProofPanels>>;
-}) {
-  const { result, proof1Failed, intentFailed, proof2Failed } = parsed;
-  const allowed = result?.allowed;
