+const INK = "#E9E4F2";
+const PASS = "#54C99A";
+const FAIL = "#E15068";
+const BRASS = "#D9A94A";
+const PENDING = "rgba(233,228,242,0.35)";
+
+import type { CSSProperties } from "react";
+
+export function monoStyle(size = 9): CSSProperties {
