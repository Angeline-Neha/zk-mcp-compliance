new file mode 100644
index 0000000..d181ee2
--- /dev/null
+++ b/frontend/src/theme.css
@@ -0,0 +1,93 @@
+/* ══════════════════════════════════════════════════════════════════
+   LIGHT THEME — design tokens and shell styles
+   Pages not yet migrated are wrapped in .legacy-dark and keep the
+   old dark look until their redesign step lands.
+   ══════════════════════════════════════════════════════════════════ */
+:root {
+  --zk-sage:   #D5DCB4;
+  --zk-beige:  #F7F4D5;
+  --zk-paper:  #FCFBEA;
+  --zk-ink:    #0A3323;
+  --zk-deep:   #3F1735;
+  --zk-pur:    #5E2750;
+  --zk-pur-bg: rgba(94, 39, 80, 0.10);
+  --zk-moss:   #839958;
+  --zk-mossd:  #53662D;
+  --zk-rose:   #D3968C;
+  --zk-red:    #A8362C;
+  --zk-tan:    #D5B893;
+  --zk-rule:   rgba(10, 51, 35, 0.16);
+  --zk-sans:   'Geist', system-ui, sans-serif;
+  --zk-mono:   'Geist Mono', ui-monospace, monospace;
+}
+
+.zk-shell {
+  position: relative;
+  background-color: var(--zk-sage);
+  color: var(--zk-ink);
+  font-family: var(--zk-sans);
+  font-size: 14px;
+  line-height: 1.45;
+  color-scheme: light;
+}
+
+.zk-main {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+  grid-column: 2;
+  grid-row: 2;
+}
+
+/* Pages awaiting their redesign keep the previous dark surface */
+.legacy-dark {
+  background-color: #0D0817;
+  color: #E9E4F2;
+  font-family: var(--font-data, 'IBM Plex Mono', monospace);
+}
+
+/* Status strip */
+.zk-live-dot {
+  width: 8px; height: 8px; border-radius: 50%;
+  background: var(--zk-moss);
+  box-shadow: 0 0 0 3px rgba(131, 153, 88, 0.3);
+}
+.zk-live-dot--off {
+  background: var(--zk-tan);
+  box-shadow: 0 0 0 3px rgba(213, 184, 147, 0.3);
+  animation: zk-blink 0.9s ease-in-out infinite;
+}
+@keyframes zk-blink { 50% { opacity: 0.3; } }
+
+/* Left rail */
+.zk-rail-btn {
+  display: flex; flex-direction: column; align-items: center; gap: 3px;
+  width: 100%; padding: 9px 2px; border: 0; border-radius: 8px;
+  background: transparent; color: var(--zk-beige); opacity: 0.75;
+  font: 500 10.5px var(--zk-sans); text-align: center; cursor: pointer;
+  transition: background 0.15s, opacity 0.15s;
+}
+.zk-rail-btn:hover { background: rgba(247, 244, 213, 0.12); opacity: 1; }
+.zk-rail-btn[aria-current="page"] { background: var(--zk-moss); color: var(--zk-ink); opacity: 1; font-weight: 700; }
+.zk-rail-btn--hl { outline: 2px solid var(--zk-rose); outline-offset: -2px; animation: zk-blink 1.4s ease-in-out infinite; }
+.zk-rail-btn svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.6; }
+
+/* Focus */
+.zk-shell button:focus-visible { outline: 3px solid var(--zk-rose); outline-offset: 2px; }
+
+/* Docket */
+.zk-docket-scroll::-webkit-scrollbar-thumb { background: rgba(247, 244, 213, 0.25); }
+.zk-docket-scroll::-webkit-scrollbar-track { background: transparent; }
+.zk-docket-row:hover { background: rgba(247, 244, 213, 0.07); }
+
+/* Board */
+.zk-board-grid {
+  background-color: var(--zk-paper);
+  background-image:
+    linear-gradient(var(--zk-rule) 1px, transparent 1px),
+    linear-gradient(90deg, var(--zk-rule) 1px, transparent 1px);
+  background-size: 28px 28px;
+  background-position: -1px -1px;
+}
