diff --git a/frontend/src/theme.css b/frontend/src/theme.css
index f75f29e..60f5ab0 100644
--- a/frontend/src/theme.css
+++ b/frontend/src/theme.css
@@ -172,3 +172,20 @@
 .log-payload { display: flex; flex-direction: column; gap: 6px; }
 .payload-label { font-size: 12px; font-weight: 600; }
 .payload-json { font: 400 12px/1.6 var(--zk-mono); color: var(--zk-beige); background: var(--zk-ink); border-radius: 6px; padding: 10px 12px; margin: 0; overflow: auto; white-space: pre-wrap; max-height: 280px; }
+
+/* ── The Wire ─────────────────────────────────────────────────── */
+@keyframes rise-in {
+  from { transform: translateY(6px); opacity: 0; }
+  to   { transform: none; opacity: 1; }
+}
+.zk-wire-grid { display: grid; grid-template-columns: 68px 22px 110px 150px 130px minmax(0, 1fr); gap: 10px; align-items: center; min-width: 760px; }
+.zk-wire-scroll { overflow-x: auto; }
+.zk-wire-scroll::-webkit-scrollbar-thumb { background: rgba(10, 51, 35, 0.25); }
+.wire-line-row { padding: 0 16px; height: 36px; border-bottom: 1px solid var(--zk-rule); animation: rise-in 0.25s ease-out both; transition: background 0.12s; }
+.wire-line-row:hover { background: rgba(94, 39, 80, 0.07); }
+.wire-line-row--fail { background: rgba(168, 54, 44, 0.06); }
+.wire-line-row:focus-visible { outline: 3px solid var(--zk-rose); outline-offset: -3px; }
+/* proof digests stay masked until the row is hovered or focused */
+.wire-redact-plain { display: none; }
+.wire-line-row:hover .wire-redact-plain, .wire-line-row:focus-visible .wire-redact-plain { display: inline; }
+.wire-line-row:hover .wire-redact-mask, .wire-line-row:focus-visible .wire-redact-mask { display: none; }
