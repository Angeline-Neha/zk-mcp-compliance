diff --git a/frontend/src/theme.css b/frontend/src/theme.css
index 912018f..f75f29e 100644
--- a/frontend/src/theme.css
+++ b/frontend/src/theme.css
@@ -95,3 +95,80 @@
 /* Inspector */
 .zk-insp .cursor-blink::after { color: var(--zk-pur); }
 .zk-insp .scrollbar-paper::-webkit-scrollbar-thumb { background: rgba(10, 51, 35, 0.25); }
+
+@keyframes stamp-land-overshoot {
+  0%   { transform: scale(2.2) rotate(-6deg); opacity: 0; }
+  60%  { transform: scale(0.94) rotate(-3deg); opacity: 1; }
+  100% { transform: scale(1) rotate(-3deg); opacity: 1; }
+}
+
+/* ── Exhibits ─────────────────────────────────────────────────── */
+.exhibits-layout { display: grid; grid-template-columns: 240px 1fr; height: 100%; overflow: hidden; font-family: var(--zk-sans); color: var(--zk-ink); }
+.exhibits-nav { display: flex; flex-direction: column; overflow-y: auto; background: var(--zk-paper); border-right: 1px solid var(--zk-rule); }
+.exhibits-nav-header { padding: 18px 16px 12px; border-bottom: 1px solid var(--zk-rule); line-height: 1.4; }
+.exhibit-nav-item { display: flex; align-items: flex-start; gap: 8px; width: 100%; padding: 11px 16px; background: none; border: 0; border-left: 3px solid transparent; border-bottom: 1px solid var(--zk-rule); cursor: pointer; text-align: left; color: var(--zk-ink); transition: background 0.15s; }
+.exhibit-nav-item:hover { background: rgba(10, 51, 35, 0.05); }
+.exhibit-nav-item.nav-item--active { background: var(--zk-pur-bg); border-left-color: var(--zk-pur); }
+.nav-item-number { font: 500 12px var(--zk-mono); color: var(--zk-pur); width: 30px; flex-shrink: 0; padding-top: 1px; }
+.nav-item-title { font: 500 13px/1.3 var(--zk-sans); }
+.exhibits-nav-footer { margin-top: auto; padding: 16px; border-top: 1px solid var(--zk-rule); display: flex; flex-direction: column; gap: 8px; }
+.nav-legend-row { display: flex; align-items: center; gap: 8px; }
+.legend-dot { width: 9px; height: 9px; border-radius: 50%; }
+.dot--blocked { background: var(--zk-red); }
+.dot--pass { background: var(--zk-moss); }
+.legend-label { font-size: 12px; opacity: 0.75; }
+
+.exhibits-canvas { padding: 22px; overflow-y: auto; height: 100%; }
+.exhibit-panel { display: flex; flex-direction: column; gap: 18px; max-width: 900px; margin: 0 auto; }
+.exhibit-header { display: flex; align-items: center; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--zk-ink); }
+.exhibit-number { font: 500 20px var(--zk-mono); color: var(--zk-pur); border: 1.5px solid var(--zk-pur); border-radius: 8px; padding: 3px 12px; background: var(--zk-paper); }
+.exhibit-titles { flex: 1; min-width: 0; }
+.exhibit-title { font: 700 20px var(--zk-sans); letter-spacing: -0.01em; margin: 0 0 2px; }
+.exhibit-tagline { font-size: 13px; opacity: 0.7; margin: 0; }
+.verdict-stamp { display: inline-block; font: 700 13px var(--zk-sans); letter-spacing: 0.04em; padding: 4px 12px; border: 2px solid; border-radius: 6px; background: var(--zk-paper); animation: stamp-land-overshoot 0.4s cubic-bezier(0.2, 1.5, 0.4, 1) forwards; }
+.exhibit-verdict--blocked .verdict-stamp { color: var(--zk-red); }
+.exhibit-verdict--pass .verdict-stamp { color: var(--zk-mossd); }
+
+.exhibit-config { background: #fff; border: 1px solid var(--zk-rule); border-radius: 10px; padding: 16px; }
+.exhibit-config-header { font-weight: 700; font-size: 13px; margin-bottom: 12px; }
+.exhibit-config-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
+@media (min-width: 700px) { .exhibit-config-grid { grid-template-columns: 1fr 1fr; } }
+.exhibit-config-field { display: flex; flex-direction: column; gap: 6px; }
+.exhibit-config-label { font-size: 12px; font-weight: 600; }
+.exhibit-config-input { font: 400 12.5px var(--zk-mono); background: var(--zk-paper); border: 1px solid var(--zk-rule); border-radius: 6px; color: var(--zk-ink); padding: 8px 10px; outline: none; }
+.exhibit-config-input:focus { border-color: var(--zk-pur); box-shadow: 0 0 0 3px var(--zk-pur-bg); }
+.exhibit-config-help { font-size: 11.5px; opacity: 0.65; margin: 0; line-height: 1.4; }
+
+.exhibit-controls { display: flex; gap: 10px; flex-wrap: wrap; }
+.exhibit-btn { font: 600 13px var(--zk-sans); padding: 10px 18px; border-radius: 8px; cursor: pointer; border: 1px solid transparent; transition: filter 0.15s; }
+.exhibit-btn:hover:not(:disabled) { filter: brightness(0.93); }
+.exhibit-btn:active:not(:disabled) { transform: translateY(1px); }
+.exhibit-btn--start { background: var(--zk-pur); color: #fff; }
+.exhibit-btn--step { background: var(--zk-ink); color: var(--zk-beige); }
+.exhibit-btn--reset { background: transparent; color: var(--zk-ink); border-color: var(--zk-ink); }
+.exhibit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
+.exhibit-btn:focus-visible, .log-entry-header:focus-visible { outline: 3px solid var(--zk-rose); outline-offset: 2px; }
+.exhibit-error { font: 400 12px var(--zk-mono); color: var(--zk-red); background: #F8E6E2; border-left: 3px solid var(--zk-red); padding: 10px 14px; border-radius: 0 6px 6px 0; }
+
+.exhibit-progress { display: flex; gap: 6px; }
+.exhibit-progress-pip { flex: 1; height: 6px; border-radius: 3px; background: rgba(10, 51, 35, 0.15); transition: background 0.2s; }
+.pip--done { background: var(--zk-moss); }
+.pip--blocked { background: var(--zk-red); }
+.pip--active { background: var(--zk-pur); animation: zk-blink 1s ease-in-out infinite; }
+
+.exhibit-log { display: flex; flex-direction: column; gap: 10px; }
+.exhibit-log-entry { background: #fff; border: 1px solid var(--zk-rule); border-radius: 8px; overflow: hidden; }
+.entry--blocked { border-left: 4px solid var(--zk-red); }
+.entry--pass { border-left: 4px solid var(--zk-moss); }
+.log-entry-header { display: flex; align-items: center; gap: 12px; padding: 12px 16px; cursor: pointer; user-select: none; }
+.log-entry-header:hover { background: rgba(10, 51, 35, 0.04); }
+.log-step-badge { font: 600 11.5px var(--zk-sans); padding: 2px 9px; border-radius: 99px; flex-shrink: 0; color: #fff; }
+.badge--blocked { background: var(--zk-red); }
+.badge--pass { background: var(--zk-mossd); }
+.log-step-label { font-weight: 600; font-size: 13.5px; flex: 1; }
+.log-expand-icon { font-size: 10px; opacity: 0.6; }
+.log-entry-body { padding: 14px 16px; border-top: 1px solid var(--zk-rule); display: flex; flex-direction: column; gap: 14px; background: var(--zk-paper); }
+.log-narration { font-size: 13.5px; line-height: 1.6; margin: 0; }
+.log-payload { display: flex; flex-direction: column; gap: 6px; }
+.payload-label { font-size: 12px; font-weight: 600; }
+.payload-json { font: 400 12px/1.6 var(--zk-mono); color: var(--zk-beige); background: var(--zk-ink); border-radius: 6px; padding: 10px 12px; margin: 0; overflow: auto; white-space: pre-wrap; max-height: 280px; }
